{
	"name": "frontend",
	"private": true,
	"type": "module",
	"scripts": {
		"gen:client": "swagger-typescript-api generate --path ../docs/swagger.json --output src/generated --name kosik.ts --module-name-first-tag",
		"dev": "bun run gen:client && vite",
		"build": "bun run gen:client && vite build && tsc",
		"serve": "vite preview",
		"test": "vitest run",
		"format": "biome format",
		"format:fix": "biome format --write",
		"lint": "biome lint",
		"lint:fix": "biome lint --write --unsafe",
		"check": "biome check",
		"check:fix": "biome check --write --unsafe",
		"biome:migrate": "biome migrate"
	},
	"dependencies": {
		"@radix-ui/react-popover": "^1.1.15",
		"@radix-ui/react-scroll-area": "^1.2.10",
		"@radix-ui/react-select": "^2.2.6",
		"@radix-ui/react-slot": "^1.2.4",
		"@radix-ui/react-tabs": "^1.1.13",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.1.18",
		"@tanstack/react-devtools": "^0.8.4",
		"@tanstack/react-form": "^1.28.5",
		"@tanstack/react-query": "^5.90.12",
		"@tanstack/react-query-devtools": "^5.91.1",
		"@tanstack/react-router": "^1.141.2",
		"@tanstack/react-router-devtools": "^1.141.2",
		"@tanstack/router-plugin": "^1.141.2",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"lucide-react": "^0.561.0",
		"react": "^19.2.3",
		"react-dom": "^19.2.3",
		"react-markdown": "^10.1.0",
		"tailwind-merge": "^3.4.0",
		"tailwindcss": "^4.1.18",
		"tw-animate-css": "^1.4.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.8",
		"@tanstack/devtools-vite": "^0.3.12",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/react": "^16.3.0",
		"@types/node": "^25.0.1",
		"@types/react": "^19.2.7",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^5.1.2",
		"babel-plugin-react-compiler": "^1.0.0",
		"swagger-typescript-api": "^13.2.16",
		"jsdom": "^27.3.0",
		"typescript": "^5.9.3",
