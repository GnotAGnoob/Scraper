{
	"$schema": "https://biomejs.dev/schemas/2.2.4/schema.json",
	"vcs": {
		"enabled": false,
		"clientKind": "git",
		"useIgnoreFile": false
	},
	"files": {
		"ignoreUnknown": false,
		"includes": ["**/*"],
		"excludes": [
			"**/.DS_Store",
			"**/node_modules/**",
			"**/build/**",
			"**/.svelte-kit/**",
			"**/package/**",
			"**/.env",
			"**/.env.local",
			"**/.env.development",
			"**/.env.production",
			"**/.env.test",
			"**/.env.ci",
			"**/.cursor/**",
			"**/pnpm-lock.yaml",
			"**/package-lock.json",
			"**/yarn.lock",
			"drizzle/meta/**",
			"**/src/routeTree.gen.ts",
			"**/src/styles.css"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"indentWidth": 4,
		"lineWidth": 120,
		"trailingCommas": "all"
	},
	"assist": { "actions": { "source": { "organizeImports": "on" } } },
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	}
}
